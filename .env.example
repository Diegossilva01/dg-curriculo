# Never put service keys or tokens in client code. Copy to .env.local (ignored).
APP_URL=
SEO_INDEXABLE=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep separate Supabase projects and MP seller/application credentials per environment.
MP_MODE=test
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
PAYMENTS_ENABLED=false
# Keep false until production Mercado Pago is configured and validated.
MP_PRODUCTION_VALIDATED=false
OFFER_VERSION=cv-specific-30d-v1
OFFER_TITLE=Um currículo · 30 dias
PRICE_CENTS=1490
# Current offer: 30 days; changing these values requires changing the server offer.
ACCESS_DURATION_DAYS=30
# One specific curriculum, fixed to the order.
RESUME_LIMIT=1
# Required explicit policy; deleting a CV does not replenish a purchased slot.
QUOTA_POLICY=distinct_documents
# Supported: revoke_on_refund_or_dispute (any partial/full refund, mediation, chargeback)
REFUND_POLICY=revoke_on_refund_or_dispute
# Comma-separated: save,export_pdf,export_docx,export_txt
OFFER_CAPABILITIES=save,export_pdf,export_docx,export_txt
SELLER_NAME=
SELLER_DOCUMENT=
LEGAL_ADDRESS=
CONTACT_EMAIL=
PRIVACY_EMAIL=
# Local macOS/Windows PDF only: full executable path to your installed Chrome.
CHROMIUM_EXECUTABLE_PATH=
# Optional integration tests only: never use production accounts.
TEST_APP_URL=
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
# Google Tag Manager: no default ID, no campaigns/tags activated by this project.
GTM_CONTAINER_ID=
MEASUREMENT_ENABLED=false
# For Tag Assistant testing only, preferably with a separate GTM container.
MEASUREMENT_ALLOW_NONPRODUCTION=false

# Optional existing test fixtures, owned by TEST_A (no fake payments).
TEST_UNPAID_RESUME_ID=
TEST_EXPIRED_RESUME_ID=
